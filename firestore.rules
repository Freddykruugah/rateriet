rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Hjelpefunksjon: er brukeren innlogget?
    function isSignedIn() {
      return request.auth != null;
    }

    // Hjelpefunksjon: er brukeren admin? (deg)
    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'fredrik-nielsen@hotmail.com';
    }

    // PARFYMER: alle kan lese. Bare admin kan legge til/endre/slette.
    match /perfumes/{perfumeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // RATINGS: alle kan lese. Innloggede kan lage. Kan bare endre/slette sine egne.
    match /ratings/{ratingId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // BRUKERE: alle kan lese (for demografi i topplister). Kan bare skrive sin egen profil.
    match /users/{userId} {
      allow read: if true;
      allow write: if isSignedIn() && request.auth.uid == userId;
    }
  }
}
